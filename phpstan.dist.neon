# PHPStan configuration, run it with "composer phpstan".
# Extensions (Symfony, PHPUnit) are registered by phpstan/extension-installer.
# To change it locally, create a phpstan.neon file (ignored by Git) that includes this one.
#
# See https://phpstan.org/config-reference

parameters:
    level: 8
    # the public API validates its arguments at runtime, PHPDoc types included: callers may not be analysed
    treatPhpDocTypesAsCertain: false
    paths:
        - packages/geocoder/src
        - packages/geocoder/tests
        - packages/routing/src
        - packages/routing/tests
        - packages/geo-bundle/config
        - packages/geo-bundle/src
        - packages/geo-bundle/tests
