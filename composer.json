{
    "name": "tito10047/meilisearch-geocoder",
    "description": "Development monorepo of tito10047/geocoder and tito10047/geocoder-bundle (not installable, use the packages)",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/console": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.9",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "rector/rector": "^2.6.4",
        "symfony/browser-kit": "^7.4.17 || ^8.1.5",
        "symfony/error-handler": "^7.4.17 || ^8.1.5",
        "symfony/filesystem": "^7.4.17 || ^8.1.5"
    },
    "replace": {
        "tito10047/geocoder": "self.version",
        "tito10047/geocoder-bundle": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\Geocoder\\": "packages/geocoder/src/",
            "Tito10047\\GeocoderBundle\\": "packages/geocoder-bundle/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tito10047\\Geocoder\\Tests\\": "packages/geocoder/tests/",
            "Tito10047\\GeocoderBundle\\Tests\\": "packages/geocoder-bundle/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse",
        "qa": [
            "@validate:packages",
            "@test",
            "@phpstan",
            "@cs"
        ],
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit",
        "validate:packages": [
            "composer validate --strict --no-check-lock --working-dir=packages/geocoder",
            "composer validate --strict --no-check-lock --working-dir=packages/geocoder-bundle"
        ]
    },
    "scripts-descriptions": {
        "cs": "Checks the coding standards (PHP-CS-Fixer)",
        "cs:fix": "Fixes the coding standards (PHP-CS-Fixer)",
        "phpstan": "Runs the static analysis (PHPStan)",
        "qa": "Runs every quality check",
        "rector": "Lists the automated refactorings (Rector)",
        "rector:fix": "Applies the automated refactorings (Rector)",
        "test": "Runs the tests (PHPUnit)",
        "validate:packages": "Validates the composer.json of every package"
    }
}
