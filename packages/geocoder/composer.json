{
    "name": "tito10047/geocoder",
    "description": "Self-hosted geocoder and address autocomplete built from OpenStreetMap data on Meilisearch, without a framework",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "geocoder",
        "geocoding",
        "autocomplete",
        "address",
        "openstreetmap",
        "photon",
        "meilisearch"
    ],
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "meilisearch/meilisearch-php": "^1.17",
        "psr/http-client": "^1.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-intl": "Compares names of every script without diacritics and case (the built-in fallback covers the European Latin alphabets)"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\Geocoder\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
