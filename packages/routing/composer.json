{
    "name": "tito10047/routing",
    "description": "Driving routes from a self-hosted Valhalla: countries crossed and tolls per country, without a framework",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "routing",
        "route",
        "directions",
        "valhalla",
        "openstreetmap",
        "toll"
    ],
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\Routing\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    }
}
