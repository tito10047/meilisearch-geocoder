{
    "name": "tito10047/geo-bundle",
    "description": "Self-hosted geocoding, address autocomplete and routing for Symfony: OpenStreetMap data on Meilisearch and Valhalla",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "geocoder",
        "geocoding",
        "autocomplete",
        "openstreetmap",
        "meilisearch"
    ],
    "authors": [
        {
            "name": "Jozef Môstka",
            "email": "jozef@mostka.sk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "meilisearch/meilisearch-php": "^1.17",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "symfony/config": "^7.4.17 || ^8.1.5",
        "symfony/console": "^7.4.17 || ^8.1.5",
        "symfony/dependency-injection": "^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^7.4.17 || ^8.1.5",
        "symfony/http-client": "^7.4.17 || ^8.1.5",
        "symfony/http-foundation": "^7.4.17 || ^8.1.5",
        "symfony/http-kernel": "^7.4.17 || ^8.1.5",
        "symfony/routing": "^7.4.17 || ^8.1.5",
        "tito10047/geocoder": "^0.3.1",
        "tito10047/routing": "^0.3"
    },
    "suggest": {
        "ext-curl": "The HTTP client of Valhalla needs ext-curl or amphp/http-client",
        "symfony/ux-autocomplete": "An address autocompleter for form fields (3.5 or newer)"
    },
    "autoload": {
        "psr-4": {
            "Tito10047\\GeoBundle\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
